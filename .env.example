# ==============================================================================
# GOOGLE GEMINI API KEY (Required for AI Summarization, Action Items & Multilingual Synthesis)
# Where to find: https://aistudio.google.com/apikey
# 1. Sign in or create an account at Google AI Studio (aistudio.google.com)
# 2. Click "Get API key" and create or copy your Gemini API key
# 3. Paste it here, or configure it in Netlify / Cloud Environment Variables
# ==============================================================================
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"

# ==============================================================================
# MICROSOFT AZURE COGNITIVE SERVICES SDK
# Where to find: https://portal.azure.com
# ==============================================================================
# Azure Speech Key for speech-to-text audio transcription via microsoft-cognitiveservices-speech-sdk
AZURE_SPEECH_KEY=""

# Azure Translation Key for text & speech translation via Azure Cognitive Services Translator
AZURE_TRANSLATION_KEY=""

# Azure Cloud Region (e.g. eastus, uksouth, westeurope)
AZURE_SPEECH_REGION="eastus"

# Host Application URL (e.g., http://localhost:3000 or https://your-site.netlify.app)
APP_URL="http://localhost:3000"

# Server Port (Default: 3000)
PORT=3000

# ==============================================================================
# MICROSOFT TEAMS & OUTLOOK INTEGRATION (Optional)
# ==============================================================================
# Incoming Webhook URL for Microsoft Teams channel notifications
TEAMS_WEBHOOK_URL=""
