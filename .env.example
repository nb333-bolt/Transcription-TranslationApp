# ==============================================================================
# GEMINI API KEY (Required for Speech Transcription, Translation & Summarization)
# Where to find: https://aistudio.google.com/app/apikey
# 1. Sign in with your Google account at Google AI Studio
# 2. Click "+ Create API Key" and copy the key string
# 3. Paste it here, or set it in your Azure App Service / Netlify Environment Variables
# ==============================================================================
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"

# Host Application URL (e.g., https://your-app.azurewebsites.net or https://your-site.netlify.app)
APP_URL="http://localhost:3000"

# Server Port (Default: 3000)
PORT=3000

# ==============================================================================
# MICROSOFT TEAMS & OUTLOOK INTEGRATION (Optional - for direct Entra ID sync)
# Where to find: https://portal.azure.com (Microsoft Entra ID > App registrations)
# ==============================================================================
# Microsoft Entra ID Application (Client) ID
AZURE_CLIENT_ID=""

# Microsoft Entra ID Directory (Tenant) ID
AZURE_TENANT_ID=""

# Microsoft Entra ID Client Secret (Certificates & Secrets)
AZURE_CLIENT_SECRET=""

# Incoming Webhook URL for Microsoft Teams channel notifications
TEAMS_WEBHOOK_URL=""

